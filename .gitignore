# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
/_isaaclab
/_uwlab/
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Tests
tests/

# Docker history
.uw-lab-docker-history

# Robot assets and datasets are built by docker/forge/g1d_pipeline.sh. Both robots' assets and the G1-D datasets are committed
# through Git LFS (see .gitattributes); everything else under data/ (local builds, backups) stays untracked.
source/uwlab_assets/data/Robots/*
!source/uwlab_assets/data/Robots/Unitree/
source/uwlab_assets/data/Robots/Unitree/*
!source/uwlab_assets/data/Robots/Unitree/G1dDex1/
!source/uwlab_assets/data/Robots/Unitree/G1Dex3/
# their USD files are exempt from the repo-wide **/*.usd rule above
!source/uwlab_assets/data/Robots/Unitree/G1dDex1/**
!source/uwlab_assets/data/Robots/Unitree/G1Dex3/**
source/uwlab_assets/data/Datasets/*
!source/uwlab_assets/data/Datasets/OmniReset_g1d_dex1/
