// VS Code Dev Container: open this repository inside the Forge image (docker/forge/Dockerfile),
// with the same layout docker/forge/run_local.sh gives a smoke test. Pylance then runs inside
// the container and resolves Isaac Sim (/isaac-sim), Isaac Lab (/opt/uwlab-deps/_isaaclab) and
// the editable uwlab extensions, so "Go to Definition" works across all of them.
//
//   docker build -f docker/forge/Dockerfile -t uwlab-omnireset:local docker/forge   # once
//   VS Code: F1 -> "Dev Containers: Reopen in Container"
//
// Pick another image from the shell VS Code is launched from (repository and tag are separate
// variables because a ${localEnv:VAR:default} default is cut at the first colon):
//   UWLAB_DEVCONTAINER_TAG=<tag> code .                         # uwlab-omnireset:<tag>
//   UWLAB_DEVCONTAINER_IMAGE=<repo> UWLAB_DEVCONTAINER_TAG=<tag> code .
{
    "name": "UW Lab (Isaac Sim 6.1 / Isaac Lab 3.0)",
    "image": "${localEnv:UWLAB_DEVCONTAINER_IMAGE:uwlab-omnireset}:${localEnv:UWLAB_DEVCONTAINER_TAG:local}",

    // The working copy is mounted where the image's editable installs expect it.
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/uwlab,type=bind",
    "workspaceFolder": "/workspace/uwlab",

    // Same stand-ins run_local.sh uses: a local folder for the blob disk, persistent Isaac Sim caches.
    "initializeCommand": "mkdir -p \"${localEnv:HOME}/.cache/uwlab-local/robotics\" \"${localEnv:HOME}/.cache/uwlab-local/isaac-cache\"",
    "mounts": [
        "source=${localEnv:HOME}/.cache/uwlab-local/robotics,target=/mnt/robotics,type=bind",
        "source=${localEnv:HOME}/.cache/uwlab-local/isaac-cache,target=/tmp/isaac-cache,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "runArgs": ["--gpus=all", "--network=host", "--ipc=host"],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },

    // The image runs as root (Isaac Sim's caches live under /root). post_create.sh hands files the
    // container creates in the working copy back to the host user.
    "remoteUser": "root",
    "postCreateCommand": "bash .devcontainer/post_create.sh",
    "postStartCommand": "bash .devcontainer/post_create.sh --start",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.black-formatter",
                "ms-python.flake8",
                "njpwerner.autodocstring",
                "streetsidesoftware.code-spell-checker",
                "ExecutableBookProject.myst-highlight"
            ],
            "settings": {
                // Isaac Sim's python.sh sets PYTHONPATH / LD_LIBRARY_PATH before exec'ing the interpreter.
                // .vscode/settings.json (generated by post_create.sh) carries the extraPaths.
                "python.defaultInterpreterPath": "/isaac-sim/python.sh",
                "python.terminal.activateEnvironment": false,
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
